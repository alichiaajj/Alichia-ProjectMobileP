<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream">
    <!-- Panah Toolbar kembali ke halaman yang membuka tutorial. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:titleTextColor="@color/teal" />
    <!-- Halaman mengisi sisa ruang layar sehingga indikator tidak tertutup. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tutorial_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <!-- Tiga titik mengikuti halaman aktif ViewPager2. -->
    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/dot_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="16dp"
        app:dotsColor="@color/muted"
        app:selectedDotColor="@color/teal"
        app:dotsCornerRadius="10dp"
        app:dotsSpacing="5dp"
        app:progressMode="true" />
    <!-- Tombol menutup tutorial dan kembali, tidak menjalankan fitur partisipasi. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/close_tutorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:text="Selesai / Kembali"
        android:textAllCaps="false"
        app:cornerRadius="24dp" />
</LinearLayout>
