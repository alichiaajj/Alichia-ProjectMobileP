<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp">
    <!-- Kotak teks pencarian atau isian sesuai desain. -->
    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_search"
        android:singleLine="true"
        android:inputType="text"
        android:textSize="14sp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:hint="Cari di lingkunganmu…"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp" />
    <!-- Wadah kategori yang dapat digulir ke samping. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">
        <!--Pertemuan 9: hanya satu kategori yang dapat dipilih. Chip dapat pindah baris di layar sempit.-->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_all"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Semua"
            android:textColor="@color/teal"
            app:chipBackgroundColor="@color/chip_background"
            android:checked="true" />
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_public"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fasilitas Umum"
            android:textColor="@color/teal"
            app:chipBackgroundColor="@color/chip_background" />
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_shop"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toko &amp; Kuliner"
            android:textColor="@color/teal"
            app:chipBackgroundColor="@color/chip_background" />
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_health"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kesehatan"
            android:textColor="@color/teal"
            app:chipBackgroundColor="@color/chip_background" />
    </com.google.android.material.chip.ChipGroup>
    <!-- Menampilkan gambar atau ikon dari drawable. -->
    <ImageView
        android:src="@drawable/neighborhood"
        android:scaleType="centerCrop"
        android:id="@+id/local_map"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Peta ilustratif lokasi fasilitas sekitar" />
    <!-- Menampilkan teks pada halaman. -->
    <TextView
        android:id="@+id/result_count"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="32dp" />
    <!-- Menampilkan teks pada halaman. -->
    <TextView
        android:id="@+id/empty"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Belum ada hasil. Coba kata kunci atau kategori lain."
        android:visibility="gone" />
    <!-- Daftar yang diisi melalui adapter sesuai modul 7. -->
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:clipToPadding="false"
        android:paddingBottom="18dp" />
</LinearLayout>
